# Generate once and keep stable for this agent identity. Never commit .env.
LIFELINE_SEED=replace-with-a-long-random-private-seed
LIFELINE_DB_PATH=lifeline.db
LIFELINE_AGENT_NAME=LifeLine Emergency Assistance
LIFELINE_AGENT_PORT=8000

# Protect the separate local provider response API.
PROVIDER_API_TOKEN=replace-with-a-long-random-token
PROVIDER_API_HOST=127.0.0.1
PROVIDER_API_PORT=8001
BOOKING_TIMEOUT_MINUTES=30

# No e-RaktKosh API integration is configured. Never put demo stock in a live answer.
ERAKTKOSH_API_BASE=
